{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cupcake-store-h",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "cupcake-store-h-db", "database_id": "1bd123e5-3cce-4220-a953-bd9630873b15", "migrations_dir": "migrations" }],
  "observability": { "enabled": false }
}
